rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public writes to form collections
    match /consultation_requests/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /quote_requests/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /contact_messages/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /feedback_submissions/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /support_requests/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /referrals/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /design_requirements/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    // Orders contain customer PII (name, email, business org number, address)
    // and the financial record of what was charged. All reads and writes go
    // through server-side API routes using the Admin SDK (which bypasses
    // these rules entirely), so direct client access is never legitimate --
    // deny it outright, matching flaggedMessages-style Admin-SDK-only data.
    match /orders/{doc} {
      allow read, write: if false;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
